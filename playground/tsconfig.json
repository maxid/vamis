{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "noEmit": true,
    "paths": {
      "@varmis/core": ["../packages/varmis-core/src/index.ts"],
      "@varmis/core/*": ["../packages/varmis-core/src/*"],
      "@varmis/ui": ["../packages/varmis-ui/src/index.ts"],
      "@varmis/ui/*": ["../packages/varmis-ui/src/*"],
      "@varmis/editor": ["../packages/varmis-editor/src/index.ts"],
      "varmis": ["../packages/varmis/src/index.ts"]
    }
  },
  "include": ["src", "../packages"]
}
