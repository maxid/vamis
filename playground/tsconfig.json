{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "noEmit": true,
    "paths": {
      "@vamis/core": ["../packages/vamis-core/src/index.ts"],
      "@vamis/core/*": ["../packages/vamis-core/src/*"],
      "@vamis/ui": ["../packages/vamis-ui/src/index.ts"],
      "@vamis/ui/*": ["../packages/vamis-ui/src/*"],
      "@vamis/editor": ["../packages/vamis-editor/src/index.ts"],
      "vamis": ["../packages/vamis/src/index.ts"]
    }
  },
  "include": ["src", "../packages", "../website/nav.d.mts"],
  "exclude": [
    "**/node_modules",
    "../packages/**/__tests__",
    "../packages/**/*.test.ts",
    "../packages/**/*.spec.ts"
  ]
}
