{
  "name": "vamis",
  "private": true,
  "version": "0.1.0",
  "description": "Vue 3 复刻的 Amis 风格 JSON/YAML 低代码运行时，Schema 作者态为 YAML，信封对齐 LCDP IR。",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @vamis/playground dev",
    "docs": "pnpm --filter @vamis/playground dev",
    "docs:build": "pnpm --filter @vamis/docs gen && pnpm --filter @vamis/docs build",
    "sdk:build": "pnpm --filter @vamis/sdk build",
    "build": "pnpm --filter @vamis/sdk build && pnpm --filter @vamis/playground build",
    "preview": "pnpm --filter @vamis/playground preview",
    "test": "pnpm --filter @vamis/formula test && pnpm --filter @vamis/core test && pnpm --filter @vamis/sdk test",
    "typecheck": "pnpm --filter @vamis/playground typecheck",
    "status": "node scripts/amis-parity.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.33.3"
}
